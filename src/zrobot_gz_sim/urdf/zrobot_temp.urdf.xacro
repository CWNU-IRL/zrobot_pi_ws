<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="zrobot_temp">
  <xacro:arg name="controllers_file" default=""/>

  <material name="gray">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.08" ixy="0.0" ixz="0.0" iyy="0.2" iyz="0.0" izz="0.2"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.22 0.10"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.22 0.10"/>
      </geometry>
    </collision>
  </link>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="segment" params="idx parent xyz">
    <link name="link_${idx}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.15"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
      <visual>
        <geometry>
          <cylinder radius="0.015" length="0.12"/>
        </geometry>
        <material name="gray"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.015" length="0.12"/>
        </geometry>
      </collision>
    </link>

    <joint name="joint_${idx}" type="revolute">
      <parent link="${parent}"/>
      <child link="link_${idx}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="40" velocity="20" lower="-3.14" upper="3.14"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:segment idx="01" parent="base_link" xyz="0.12 0.08 0.00"/>
  <xacro:segment idx="02" parent="link_01" xyz="0.08 0.00 -0.04"/>
  <xacro:segment idx="03" parent="link_02" xyz="0.08 0.00 -0.04"/>
  <xacro:segment idx="04" parent="base_link" xyz="0.12 -0.08 0.00"/>
  <xacro:segment idx="05" parent="link_04" xyz="0.08 0.00 -0.04"/>
  <xacro:segment idx="06" parent="link_05" xyz="0.08 0.00 -0.04"/>
  <xacro:segment idx="07" parent="base_link" xyz="-0.12 0.08 0.00"/>
  <xacro:segment idx="08" parent="link_07" xyz="-0.08 0.00 -0.04"/>
  <xacro:segment idx="09" parent="link_08" xyz="-0.08 0.00 -0.04"/>
  <xacro:segment idx="10" parent="base_link" xyz="-0.12 -0.08 0.00"/>
  <xacro:segment idx="11" parent="link_10" xyz="-0.08 0.00 -0.04"/>
  <xacro:segment idx="12" parent="link_11" xyz="-0.08 0.00 -0.04"/>
  <xacro:segment idx="13" parent="base_link" xyz="0.00 0.00 0.06"/>
  <xacro:segment idx="14" parent="link_13" xyz="0.06 0.00 0.00"/>
  <xacro:segment idx="15" parent="link_14" xyz="0.06 0.00 0.00"/>
  <xacro:segment idx="16" parent="link_15" xyz="0.06 0.00 0.00"/>
  <xacro:segment idx="17" parent="link_16" xyz="0.06 0.00 0.00"/>
  <xacro:segment idx="18" parent="link_17" xyz="0.06 0.00 0.00"/>
  <xacro:segment idx="19" parent="link_18" xyz="0.06 0.00 0.00"/>
  <xacro:segment idx="20" parent="link_19" xyz="0.06 0.00 0.00"/>
  <xacro:segment idx="21" parent="link_20" xyz="0.06 0.00 0.00"/>
  <xacro:segment idx="22" parent="link_21" xyz="0.06 0.00 0.00"/>
  <xacro:segment idx="23" parent="link_22" xyz="0.06 0.00 0.00"/>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>imu/data</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint_01"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_02"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_03"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_04"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_05"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_06"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_07"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_08"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_09"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_10"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_11"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_12"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_13"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_14"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_15"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_16"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_17"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_18"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_19"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_20"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_21"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_22"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    <joint name="joint_23"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>
</robot>
